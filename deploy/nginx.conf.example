# Example only. Replace hostnames and certificate paths before use.
# Keep AEGIS bound to localhost and place TLS/rate limiting at the edge.

limit_req_zone $binary_remote_addr zone=aegis_operator:10m rate=10r/s;

server {
    listen 80;
    server_name aegis.example.invalid;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name aegis.example.invalid;

    ssl_certificate     /etc/letsencrypt/live/aegis.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aegis.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        limit_req zone=aegis_operator burst=30 nodelay;
        proxy_pass http://127.0.0.1:8600;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        client_max_body_size 128k;
    }
}
