# Keep the collector bound to localhost unless a reverse proxy/firewall explicitly protects it.
AEGIS_BIND=127.0.0.1:8600
AEGIS_DATABASE_PATH=/data/aegis.db
AEGIS_INGEST_API_KEY=change-me-with-a-long-random-secret
AEGIS_MAX_EVENT_BYTES=65536
AEGIS_RETENTION_DAYS=30
# Safe default: passwords are fingerprinted and redacted, not stored in cleartext.
AEGIS_STORE_CREDENTIAL_SECRETS=false
