# Operator console / collector
AEGIS_DATABASE_PATH=/data/aegis.db
# Compose uses distinct sensor secrets by default. Generate independent random values.
AEGIS_SSH_SENSOR_API_KEY=change-me-ssh-with-a-long-random-secret
AEGIS_WEB_SENSOR_API_KEY=change-me-web-with-a-different-long-random-secret
AEGIS_LEGACY_SENSOR_API_KEY=change-me-legacy-with-a-different-long-random-secret
AEGIS_SMTP_SENSOR_API_KEY=change-me-smtp-with-a-different-long-random-secret
AEGIS_REDIS_SENSOR_API_KEY=change-me-redis-with-a-different-long-random-secret
AEGIS_MYSQL_SENSOR_API_KEY=change-me-mysql-with-a-different-long-random-secret
AEGIS_SMB_SENSOR_API_KEY=change-me-smb-with-a-different-long-random-secret
# Optional: required only when the generic TCP Compose profile is enabled.
AEGIS_GENERIC_SENSOR_API_KEY=
# Optional unless you ingest Suricata EVE telemetry.
AEGIS_SURICATA_SENSOR_API_KEY=
AEGIS_OPERATOR_API_KEY=change-me-operator-with-a-different-long-random-secret
# Unsafe direct-development-only escape hatch. Hardened Docker Compose still requires AEGIS_OPERATOR_API_KEY.
AEGIS_ALLOW_UNAUTHENTICATED_OPERATOR=false
# Legacy/shared fallback for direct non-Compose deployments only. Leave empty when SENSOR_KEYS is used.
AEGIS_INGEST_API_KEY=
# Direct deployments may provide the allowlist explicitly:
# AEGIS_SENSOR_KEYS={"ssh-decoy-01":"replace-me","web-decoy-01":"replace-me","legacy-decoy-01":"replace-me","smtp-decoy-01":"replace-me","redis-decoy-01":"replace-me","mysql-decoy-01":"replace-me","smb-decoy-01":"replace-me","generic-tcp-decoy-01":"replace-me","suricata-01":"replace-me"}
AEGIS_MAX_EVENT_BYTES=65536
AEGIS_RETENTION_DAYS=30
AEGIS_MAX_DB_EVENTS=500000
AEGIS_ANALYTICS_MAX_EVENTS=20000
# Caps events loaded at once for one session timeline/graph/report/study analysis.
AEGIS_SESSION_MAX_EVENTS=5000
# Caps nodes returned by the evidence relationship graph; truncation is disclosed in the UI/API.
AEGIS_RELATION_MAX_NODES=160
# Readiness fails below this free-space threshold (default 64 MiB).
AEGIS_MIN_FREE_BYTES=67108864
AEGIS_MAX_CASES=10000
# 0 disables automatic case deletion. When enabled, only closed cases older than this are removed.
AEGIS_CASE_RETENTION_DAYS=0
AEGIS_STORE_CREDENTIAL_SECRETS=false
AEGIS_SESSION_GAP_MINUTES=15
# Reject sensor event timestamps farther into the future than this collector clock tolerance.
AEGIS_MAX_FUTURE_EVENT_SKEW_SECONDS=300

# Optional PCAP evidence mode. Disabled by default because packet captures may contain sensitive payloads.
# The collector never gains raw-socket privileges by enabling this storage mode.
AEGIS_PCAP_ENABLED=false
AEGIS_PCAP_DIR=/data/pcap
AEGIS_PCAP_MAX_BYTES=1048576
AEGIS_PCAP_RETENTION_DAYS=7
AEGIS_PCAP_MAX_FILES=1000

# Signed sensor transport and bounded ingestion
AEGIS_REQUIRE_SENSOR_SIGNATURE=true
AEGIS_SIGN_SENSOR_REQUESTS=true
AEGIS_SENSOR_SIGNATURE_MAX_SKEW=300
AEGIS_INGEST_RATE_LIMIT_PER_MINUTE=600
AEGIS_OPERATOR_RATE_LIMIT_PER_MINUTE=1200
AEGIS_SENSOR_TIMEOUT=2.0
AEGIS_SENSOR_MAX_CONNECTIONS=32
# Sensors send authenticated liveness heartbeats separately from attack telemetry.
AEGIS_SENSOR_HEARTBEAT_INTERVAL_SECONDS=60
# Collector marks heartbeat contact stale after this many seconds; stale does not identify the cause.
AEGIS_SENSOR_HEARTBEAT_STALE_SECONDS=180
# Optional deployment persona shared by built-in decoys. Keep this operator-controlled.
# Optional stable seed varies built-in default fingerprints between deployments without exposing the seed.
# AEGIS_DECOY_PERSONA_SEED=replace-with-a-random-deployment-specific-value
# Supported fields include hostname, username, protocol banners/versions and bounded fake_files.
# AEGIS_DECOY_PERSONA_JSON={"name":"branch-office","hostname":"filesrv-02","username":"svcops","web_title":"Operations Portal","web_heading":"Operations Staff Portal","smtp_hostname":"mail02","ftp_banner":"Internal FTP Service","telnet_banner":"Operations Gateway","redis_version":"7.0.15","mysql_version":"8.0.34","fake_files":{"/etc/hostname":"filesrv-02\\n","/home/svcops/readme.txt":"Maintenance window: Sunday 02:00 UTC.\\n"}}
# Direct deployments may alternatively mount a <=64 KiB JSON file and set:
# AEGIS_DECOY_PERSONA_FILE=/run/secrets/aegis-persona.json
# Optional honeytoken feature. Leave empty to disable. Use a deployment-specific random value.
# When enabled, sensors plant a synthetic credential in decoy content and the collector can
# raise a high-confidence alert if the same username+secret fingerprint is later observed.
# AEGIS_HONEYTOKEN_SEED=replace-with-a-random-deployment-specific-value
# Direct sensor processes use AEGIS_SENSOR_API_KEY. Compose maps each dedicated key above to it.
# AEGIS_SENSOR_API_KEY=replace-me

# Optional local/offline GeoIP and ASN enrichment.
# Mount operator-supplied MaxMind GeoIP2/GeoLite2 MMDB files into the collector.
# AEGIS_GEOIP_CITY_DB=/geoip/GeoLite2-City.mmdb
# AEGIS_GEOIP_ASN_DB=/geoip/GeoLite2-ASN.mmdb
# AEGIS_GEOIP_DIR=./geoip

# Optional local/offline threat context exact-match feed.
# Keep the feed outside Git and mount it read-only into the collector.
# AEGIS_THREAT_CONTEXT_FILE=/threat-context/feed.json
# AEGIS_THREAT_CONTEXT_DIR=./threat-context
AEGIS_THREAT_CONTEXT_MAX_BYTES=20971520
AEGIS_THREAT_CONTEXT_MAX_INDICATORS=100000
AEGIS_THREAT_CONTEXT_MAX_MATCHES=32

# Backups
AEGIS_BACKUP_DIR=/data/backups
AEGIS_BACKUP_KEEP=14

# Sensor exposure CIDRs. Keep them dedicated and non-overlapping with host/LAN/VPN networks.
# The host-side egress guard uses these source ranges to block sensor-initiated outbound traffic
# while permitting replies to inbound honeypot connections.
AEGIS_SSH_EXPOSURE_SUBNET=172.30.101.0/24
AEGIS_WEB_EXPOSURE_SUBNET=172.30.102.0/24
AEGIS_LEGACY_EXPOSURE_SUBNET=172.30.103.0/24
AEGIS_SMTP_EXPOSURE_SUBNET=172.30.104.0/24
AEGIS_REDIS_EXPOSURE_SUBNET=172.30.105.0/24
AEGIS_MYSQL_EXPOSURE_SUBNET=172.30.106.0/24
AEGIS_SMB_EXPOSURE_SUBNET=172.30.107.0/24
AEGIS_GENERIC_EXPOSURE_SUBNET=172.30.108.0/24

# Per-sensor internal management CIDRs. The collector binds each built-in sensor identity
# to its expected source subnet and denies operator/UI access from these networks.
AEGIS_SSH_MGMT_SUBNET=172.31.101.0/24
AEGIS_WEB_MGMT_SUBNET=172.31.102.0/24
AEGIS_LEGACY_MGMT_SUBNET=172.31.103.0/24
AEGIS_SMTP_MGMT_SUBNET=172.31.104.0/24
AEGIS_REDIS_MGMT_SUBNET=172.31.105.0/24
AEGIS_MYSQL_MGMT_SUBNET=172.31.106.0/24
AEGIS_SMB_MGMT_SUBNET=172.31.107.0/24
AEGIS_GENERIC_MGMT_SUBNET=172.31.108.0/24
# Direct/custom deployments may override the mapping explicitly:
# AEGIS_SENSOR_SOURCE_CIDRS={"ssh-decoy-01":"172.31.101.0/24","web-decoy-01":"172.31.102.0/24","legacy-decoy-01":"172.31.103.0/24","smtp-decoy-01":"172.31.104.0/24","redis-decoy-01":"172.31.105.0/24","mysql-decoy-01":"172.31.106.0/24","smb-decoy-01":"172.31.107.0/24","generic-tcp-decoy-01":"172.31.108.0/24"}

# Public decoy ports. Use firewall/NAT to expose only what the lab requires.
AEGIS_PUBLIC_SSH_PORT=2222
AEGIS_PUBLIC_WEB_PORT=8080
AEGIS_PUBLIC_FTP_PORT=2121
AEGIS_PUBLIC_TELNET_PORT=2323
AEGIS_PUBLIC_SMTP_PORT=2525
AEGIS_PUBLIC_REDIS_PORT=6379
AEGIS_PUBLIC_MYSQL_PORT=3306
AEGIS_PUBLIC_SMB_PORT=445
# Generic TCP is opt-in: docker compose --profile generic up -d generic-tcp-decoy
AEGIS_PUBLIC_GENERIC_TCP_PORT=9000
AEGIS_GENERIC_TCP_BANNER=Service ready
