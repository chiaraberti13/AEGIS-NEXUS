# Operator console / collector
AEGIS_DATABASE_PATH=/data/aegis.db
# Compose uses distinct sensor secrets by default. Generate independent random values.
AEGIS_SSH_SENSOR_API_KEY=change-me-ssh-with-a-long-random-secret
AEGIS_WEB_SENSOR_API_KEY=change-me-web-with-a-different-long-random-secret
AEGIS_LEGACY_SENSOR_API_KEY=change-me-legacy-with-a-different-long-random-secret
# Optional unless you ingest Suricata EVE telemetry.
AEGIS_SURICATA_SENSOR_API_KEY=
AEGIS_OPERATOR_API_KEY=change-me-operator-with-a-different-long-random-secret
# Legacy/shared fallback for direct non-Compose deployments only. Leave empty when SENSOR_KEYS is used.
AEGIS_INGEST_API_KEY=
# Direct deployments may provide the allowlist explicitly:
# AEGIS_SENSOR_KEYS={"ssh-decoy-01":"replace-me","web-decoy-01":"replace-me","legacy-decoy-01":"replace-me","suricata-01":"replace-me"}
AEGIS_MAX_EVENT_BYTES=65536
AEGIS_RETENTION_DAYS=30
AEGIS_MAX_DB_EVENTS=500000
AEGIS_ANALYTICS_MAX_EVENTS=20000
# Readiness fails below this free-space threshold (default 64 MiB).
AEGIS_MIN_FREE_BYTES=67108864
AEGIS_MAX_CASES=10000
# 0 disables automatic case deletion. When enabled, only closed cases older than this are removed.
AEGIS_CASE_RETENTION_DAYS=0
AEGIS_STORE_CREDENTIAL_SECRETS=false
AEGIS_SESSION_GAP_MINUTES=15

# Signed sensor transport and bounded ingestion
AEGIS_REQUIRE_SENSOR_SIGNATURE=true
AEGIS_SIGN_SENSOR_REQUESTS=true
AEGIS_SENSOR_SIGNATURE_MAX_SKEW=300
AEGIS_INGEST_RATE_LIMIT_PER_MINUTE=600
AEGIS_OPERATOR_RATE_LIMIT_PER_MINUTE=1200
AEGIS_SENSOR_TIMEOUT=2.0
AEGIS_SENSOR_MAX_CONNECTIONS=32
# Direct sensor processes use AEGIS_SENSOR_API_KEY. Compose maps each dedicated key above to it.
# AEGIS_SENSOR_API_KEY=replace-me

# Optional local/offline GeoIP and ASN enrichment.
# Mount operator-supplied MaxMind GeoIP2/GeoLite2 MMDB files into the collector.
# AEGIS_GEOIP_CITY_DB=/geoip/GeoLite2-City.mmdb
# AEGIS_GEOIP_ASN_DB=/geoip/GeoLite2-ASN.mmdb
# AEGIS_GEOIP_DIR=./geoip

# Backups
AEGIS_BACKUP_DIR=/data/backups
AEGIS_BACKUP_KEEP=14

# Public decoy ports. Use firewall/NAT to expose only what the lab requires.
AEGIS_PUBLIC_SSH_PORT=2222
AEGIS_PUBLIC_WEB_PORT=8080
AEGIS_PUBLIC_FTP_PORT=2121
AEGIS_PUBLIC_TELNET_PORT=2323
